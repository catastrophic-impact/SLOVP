{
  "name": "slovp",
  "version": "0.1.1",
  "description": "Simple Local Online Video Player: YouTube and Rumble in two tabs, played with MPV and yt-dlp",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dist": "electron-builder --linux AppImage"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "author": "catastrophic-impact",
  "build": {
    "appId": "local.slovp.app",
    "productName": "SLOVP",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/yt-dlp_linux",
        "to": "bin/yt-dlp"
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "artifactName": "SLOVP-${version}.AppImage"
    },
    "afterPack": "scripts/after-pack.js"
  }
}
